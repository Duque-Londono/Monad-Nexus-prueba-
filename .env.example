# Monad Nexus - Variables de Entorno
# Renombrar a .env y completar con los valores reales

# RPC de Monad Testnet (obtener en dashboard.alchemy.com)
RPC_URL=https://monad-testnet.g.alchemy.com/v2/TU_API_KEY

# Clave privada de la wallet que desplegara los contratos
PRIVATE_KEY=0x_tu_clave_privada_aqui

# Direcciones de los contratos (se llenan despues del despliegue)
ENGINE_ADDRESS=0x0000000000000000000000000000000000000000
WORKER_ADDRESS=0x0000000000000000000000000000000000000000
DONATION_ADDRESS=0x0000000000000000000000000000000000000000
